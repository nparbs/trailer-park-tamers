{
  "name": "trailer-park-tamers",
  "private": true,
  "version": "0.5.0",
  "description": "A GBA-style monster-catcher parody with a shared online world.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shots": "node scripts/screenshots.mjs",
    "build:server": "node scripts/build-server.mjs",
    "server": "node scripts/build-server.mjs && node dist-server/index.mjs",
    "ship": "node scripts/ship.mjs"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "5.2.7",
    "phaser": "3.90.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.12",
    "playwright-core": "1.56.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
