# Copy to .env on the server. Nothing in here is secret.

# Where the game page is served. The server refuses WebSocket connections from anywhere else.
ALLOWED_ORIGINS=https://tpt.parbs.online

# Cloudflare passes the player's real address in this header.
CLIENT_IP_HEADER=cf-connecting-ip

# The Docker network that Scrap Riot's cloudflared container is on.
TUNNEL_NETWORK=scrap-riot_default
